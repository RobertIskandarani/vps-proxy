# Caddyfile central: un bloque por dominio → contenedor de cada app en la red
# `edge`. Se rutea por NOMBRE de contenedor (evita choques de "web"/"api" entre
# proyectos). Agregar una app = agregar su bloque acá y recargar.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# ── one-marketing ─────────────────────────────────────────────────────────
one.wearesofly.com {
	encode gzip
	import security_headers
	handle /api/* {
		reverse_proxy one-prod-api-1:3001 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy one-prod-web-1:3000
	}
}

# ── iskalibur (staging) ───────────────────────────────────────────────────
staging.iskalibur.com {
	encode gzip
	import security_headers
	handle /api/* {
		reverse_proxy iskalibur-staging-api-1:3001 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy iskalibur-staging-web-1:3000
	}
}
